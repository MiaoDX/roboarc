{
  "$defs": {
    "CapabilityRef": {
      "additionalProperties": false,
      "description": "Exact reference to a capability contract version.",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "CapabilityRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Capabilities available through one adapter/configuration.",
  "properties": {
    "adapter": {
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
      "title": "Adapter",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/CapabilityRef"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "id": {
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
      "title": "Id",
      "type": "string"
    },
    "profile_schema_version": {
      "const": 1,
      "default": 1,
      "title": "Profile Schema Version",
      "type": "integer"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "adapter",
    "capabilities"
  ],
  "title": "RobotProfile",
  "type": "object"
}
